# This file contains environment variables required by the build and deploy scripts.
# Copy this file to .env and fill in your project-specific values.
# The .env file is ignored by git.

# Google Cloud Project ID
GCP_PROJECT_ID="jarvis-444507"

# Artifact Registry region
ARTIFACT_REGISTRY_REGION="us-central1"

# Artifact Registry repository name
IMAGE_REPO_NAME="docling-images"

# Image name for the docling-serve application
IMAGE_NAME="docling-service-gpu-http2"

# Image tag (e.g., latest, v1.0)
IMAGE_TAG="latest"

# Cloud Run Job name
CLOUD_RUN_JOB_NAME="docling-job-gpu"

# Cloud Run region
CLOUD_RUN_REGION="us-central1"